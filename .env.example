# Copy to .env and replace every placeholder. Never commit .env.
APP_ENV=development

# --- PostgreSQL (local in dev; Render Postgres in production) ---
DATABASE_URL=postgresql+psycopg://propflow:CHANGE_ME@localhost:5432/propflow
TEST_DATABASE_URL=postgresql+psycopg://propflow:CHANGE_ME@localhost:5432/propflow_test

# --- Redis (local in dev; Render Key Value in production) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
RATELIMIT_STORAGE_URI=redis://localhost:6379/2

# --- Security ---
SECRET_KEY=replace-me
FRONTEND_ORIGIN=http://localhost:3000

# --- Object storage (S3-compatible; configured in Phase 7) ---
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto

# --- Email (dev prints emails to the console; real provider configured later) ---
EMAIL_BACKEND=console
MAIL_FROM=no-reply@propflow.local

# --- Sessions (optional; defaults shown) ---
SESSION_IDLE_TIMEOUT_SECONDS=259200
SESSION_ABSOLUTE_TIMEOUT_SECONDS=1209600

# --- Reverse proxies (production) ---
# Proxy hops in front of the API (Vercel + Render). Keep 0 until verified against real headers.
TRUSTED_PROXY_COUNT=0
